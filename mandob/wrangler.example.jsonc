{
  // Review-only template. No resources exist for Mandob and this file is not wrangler.jsonc.
  "name": "mandob-baghdad-ai",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "PAGE_ID": "REQUIRES_AUTHORIZED_META_PAGE",
    "GRAPH_VERSION": "REVIEW_SUPPORTED_VERSION_BEFORE_ACTIVATION",
    "ALLOW_AI": "false",
    "ALLOW_MEDIA": "false",
    "ALLOW_SEND": "false",
    "ALLOW_ALERT_SEND": "false",
    "AI_DAILY_CALL_LIMIT": "0",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mandob-baghdad-db",
      "database_id": "REQUIRES_SEPARATE_DATABASE",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": [] },
  // Later, after review: private PHOTOS R2 binding, AI binding, and recovery schedule.
  // Secrets must be installed using Cloudflare Secrets, never committed or pasted into chat.
}
