{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waseet-telegram-bot",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "./miniapp",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/webhook",
      "/health",
      "/media/*",
      "/internal/*"
    ],
    "html_handling": "none"
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "BOT_USERNAME": "WaseetIraqMarketBot",
    "WANTED_RADAR_ENABLED": "true",
    "INTELLIGENCE_READY": "true",
    "SUPABASE_URL": "https://beyrctbxojpuvhevfyok.supabase.co",
    "SERVICES_READY": "false",
    "REWARDS_APPROVED": "true",
    "BROADCAST_APPROVED": "false"
  },
  "keep_vars": true,
  "preview_urls": false,
  "services": [
    {
      "binding": "AGENT_DRAFTS",
      "service": "smart-ad-radar"
    }
  ],
  "d1_databases": [
    {
      "binding": "OPS",
      "database_name": "smart-ad-radar-db",
      "database_id": "8e9d67f8-b043-4868-8cc1-b10a5749f115"
    }
  ]
}
